<Window x:Class="GmailCalendarNotifier.ReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GmailCalendarNotifier"
        Title="Reminders"
        Width="560" MinHeight="300" SizeToContent="Height"
        WindowStartupLocation="Manual"
        ShowInTaskbar="True"
        Topmost="True"
        ResizeMode="CanResizeWithGrip"
        Background="#FFF3F3F3"
        FontFamily="Segoe UI">

    <Window.Resources>
        <local:EmptyToCollapsedConverter x:Key="EmptyToCollapsed"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock x:Name="HeaderText" Grid.Row="0"
                   Text="1 Reminder" FontSize="15" FontWeight="SemiBold"
                   Foreground="#FF1F3A5F" Margin="2,0,0,8"/>

        <!-- Reminder list -->
        <Border Grid.Row="1" Background="White" BorderBrush="#FFD0D0D0"
                BorderThickness="1" CornerRadius="3" MaxHeight="420">
            <ListBox x:Name="ReminderList" BorderThickness="0" Background="Transparent"
                     SelectionMode="Extended"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="6,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#FF2B7DE9" CornerRadius="2" Margin="0,1,8,1"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                           FontSize="14" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding WhenText}" Foreground="#FF444444"
                                           FontSize="12" Margin="0,1,0,0"/>
                                <TextBlock Text="{Binding StatusText}" Foreground="#FFC0392B"
                                           FontSize="12" FontWeight="SemiBold" Margin="0,1,0,0"/>
                                <TextBlock Text="{Binding Location}" Foreground="#FF666666"
                                           FontSize="12" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding ShowPlainLocation, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock FontSize="12" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding HasLink, Converter={StaticResource BoolToVis}}">
                                    <Hyperlink NavigateUri="{Binding LinkUrl}"
                                               RequestNavigate="Location_RequestNavigate">
                                        <Run Text="{Binding LinkText, Mode=OneWay}"/>
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="2" Content="Open in Calendar"
                                    VerticalAlignment="Center" Margin="8,0,2,0" Padding="10,5"
                                    Click="OpenInCalendar_Click"
                                    ToolTip="Open this event in Google Calendar"
                                    Visibility="{Binding HasWebUrl, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Snooze row -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Snooze:" VerticalAlignment="Center" Margin="2,0,8,0"/>
            <ComboBox x:Name="SnoozeCombo" Grid.Column="1" Height="26"
                      VerticalContentAlignment="Center" SelectedIndex="1"/>
        </Grid>

        <!-- Buttons -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="DismissAllButton" Grid.Column="0" Content="Dismiss All"
                    Height="34" Padding="14,0" Click="DismissAll_Click"/>
            <Button x:Name="SnoozeButton" Grid.Column="2" Content="Snooze"
                    Height="34" Padding="22,0" Margin="0,0,8,0" Click="Snooze_Click"/>
            <Button x:Name="DismissButton" Grid.Column="3" Content="Dismiss"
                    Height="34" Padding="22,0" Click="Dismiss_Click"/>
        </Grid>
    </Grid>
</Window>
